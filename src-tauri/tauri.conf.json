{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lipszyc Video Downloader",
  "mainBinaryName": "LipszycVideoDownloader",
  "version": "1.0.0",
  "identifier": "com.lipszyc.videodownloader",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lipszyc Video Downloader",
        "label": "main",
        "width": 720,
        "height": 680,
        "resizable": false,
        "maximizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
