{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mom’s Video Downloader",
  "mainBinaryName": "MomsVideoDownloader",
  "version": "0.1.0",
  "identifier": "com.videodownloader.momsvideodownloader",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mom’s Video Downloader",
        "label": "main",
        "width": 720,
        "height": 680,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
