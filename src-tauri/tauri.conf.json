{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MomsVideoDownloader",
  "mainBinaryName": "MomsVideoDownloader",
  "version": "1.0.0",
  "identifier": "com.shaked.momsvideodownloader",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MomsVideoDownloader",
        "label": "main",
        "width": 720,
        "height": 640,
        "minWidth": 560,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
